# API process
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smartslot
MONGODB_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared API-to-scheduler service authentication; use the same value for both processes.
SCHEDULER_URL=http://127.0.0.1:8000
SCHEDULER_API_TOKEN=replace-with-a-separate-long-random-service-token
SCHEDULER_CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Optional Vite development proxy override (default targets the local API).
API_PROXY_TARGET=http://127.0.0.1:4000
